<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="AssetTagReportSubreport" language="groovy" columnCount="2" pageWidth="595" pageHeight="99" columnWidth="297" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="b84dcdd2-5586-4d40-9cf8-58192c4f5975">
	<property name="ireport.zoom" value="1.9487171000000014"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="P_RPT_SELECTED_VALUES_LIST" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT FAM.FA_POID,FAM.FA_CODE,FAM.FA_DESCRIPTION AS DESCRIPTION,
       CASE WHEN HEM.EMPLOYEE_NAME IS NOT NULL THEN HEM.EMPLOYEE_NAME
            WHEN HEM.EMPLOYEE_NAME IS NULL THEN FAM.FA_OWNER
       END AS OWNER,FAM.WARRANTY_PERIOD,NVL(ASM.SUPPLIER_NAME,FAM.AMC_SUPPLIER) AS AMC_SUPPLIER,FAM.LOCATION_POID,
FAM.PURCHASE_DATE, FAM.SERIAL_NO, FAM.MODEL_NO,ADD_MONTHS(FAM.PURCHASE_DATE,FAM.WARRANTY_PERIOD) AS EXP_DATE,FAM.BRAND
FROM FIXED_ASSET_MASTER FAM
LEFT JOIN FIXED_ASSET_CATEGORY_MASTER CM ON FAM.FA_CATEGORY_POID = CM.FA_CATEGORY_POID
LEFT JOIN HR_EMPLOYEE_MASTER HEM ON HEM.EMPLOYEE_POID=FAM.EMPLOYEE_POID
LEFT JOIN AP_SUPPLIER_MASTER ASM ON ASM.SUPPLIER_POID=FAM.SUPPLIER_POID
WHERE FAM.FA_POID IN(SELECT * FROM TABLE(FUNC_GLOB_SPLIT_STRING($P{P_RPT_SELECTED_VALUES_LIST},','))) AND CM.ASSET_TYPE='OFFICE_EQUIPMENTS'
      AND NVL(FAM.ACTIVE,'Y')='Y'
      AND FAM.COMPANY_POID LIKE (CASE WHEN 999 IS NULL OR 999 = 999 THEN '%'
                                 ELSE TO_CHAR(999) END )
ORDER BY FAM.LOCATION_POID ASC ,FAM.FA_DESCRIPTION DESC]]>
	</queryString>
	<field name="FA_POID" class="java.math.BigDecimal"/>
	<field name="FA_CODE" class="java.lang.String"/>
	<field name="DESCRIPTION" class="java.lang.String"/>
	<field name="OWNER" class="java.lang.String"/>
	<field name="WARRANTY_PERIOD" class="java.lang.String"/>
	<field name="AMC_SUPPLIER" class="java.lang.String"/>
	<field name="LOCATION_POID" class="java.math.BigDecimal"/>
	<field name="PURCHASE_DATE" class="java.sql.Timestamp"/>
	<field name="SERIAL_NO" class="java.lang.String"/>
	<field name="MODEL_NO" class="java.lang.String"/>
	<field name="EXP_DATE" class="java.sql.Timestamp"/>
	<field name="BRAND" class="java.lang.String"/>

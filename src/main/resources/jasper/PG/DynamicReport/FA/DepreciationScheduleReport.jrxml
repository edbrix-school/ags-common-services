	<parameter name="REPORT_DATE" class="java.util.Date"/>
	<queryString>
		<![CDATA[SELECT DISTINCT COMPANY_NAME FROM (
    SELECT
        CASE WHEN $P{COMPANY} = '999' THEN 'All Companies'
             ELSE GCM.COMPANY_NAME
        END AS COMPANY_NAME
    FROM GLOBAL_COMPANY_MASTER GCM
    WHERE CAST($P{COMPANY} AS INTEGER) = 999
       OR GCM.COMPANY_POID = CAST($P{COMPANY} AS INTEGER)
) as subquery]]>
	</queryString>

	<subDataset name="Depreciation" uuid="2e6eff22-5378-4797-8b52-99246327b0b9">
		<parameter name="COMPANY" class="java.lang.String" isForPrompting="false"/>
		<parameter name="DEP_DATE" class="java.lang.String"/>
		<parameter name="ASSET_TYPE" class="java.lang.String"/>
		<!-- CHANGE: Replaced Oracle {call PROC_FA_DEPRECIATION_RPT_PRINT(..., ORACLE_REF_CURSOR)} with
		     PostgreSQL wrapper function fn_fa_depreciation_rpt_print() that returns TABLE.
		     COMPANY is multiselect array (numeric[]) in PostgreSQL; Oracle used single NUMBER.
		     No schema prefix - schema resolved at runtime. -->
		<queryString language="sql">
			<![CDATA[SELECT * FROM fn_fa_depreciation_rpt_print(  string_to_array($P{COMPANY}, ',')::numeric[] , $P{DEP_DATE}::date, $P{ASSET_TYPE} )]]>
		</queryString>

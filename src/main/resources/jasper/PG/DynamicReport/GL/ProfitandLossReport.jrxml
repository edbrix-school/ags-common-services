<subDataset name="ProfitandLoss" uuid="dd6b8263-f007-4284-9919-0f7833ca03ff">
<parameter name="PERIOD" class="java.lang.String"/>
<parameter name="PERIOD2" class="java.lang.String"/>
<parameter name="COMPANY_POID" class="java.lang.String"/>
<!-- COMPANY_POID holds only the first selected company; COMPANY_POID_CSV carries the full multiselect list -->
<parameter name="COMPANY_POID_CSV" class="java.lang.String"/>
<parameter name="COST_POID" class="java.lang.String"/>
<parameter name="LEVEL_LIMIT" class="java.lang.String"/>
<queryString language="sql">
<![CDATA[SELECT * FROM fn_gl_ledger_profit_loss_rpt($P{PERIOD}::date, $P{PERIOD2}::date, string_to_array(translate(CAST($P{COMPANY_POID_CSV} AS TEXT), '{} ', ''), ',')::numeric[], $P{COST_POID}::varchar, $P{LEVEL_LIMIT}::varchar)]]>
</queryString>
<field name="GL_POID" class="java.lang.String"/>
<field name="FLVL" class="java.math.BigDecimal"/>
<field name="LVL" class="java.math.BigDecimal"/>
<field name="GL_CODE" class="java.lang.String"/>
<field name="DESCRIPTION" class="java.lang.String"/>
<field name="OPENING_BALANCE_DR" class="java.math.BigDecimal"/>
<field name="OPENING_BALANCE_CR" class="java.math.BigDecimal"/>
<field name="DR_AMT" class="java.math.BigDecimal"/>
<field name="CR_AMT" class="java.math.BigDecimal"/>
<field name="CLOSING_BALANCE_DR" class="java.math.BigDecimal"/>
<field name="CLOSING_BALANCE_CR" class="java.math.BigDecimal"/>
</subDataset>
<parameter name="PERIOD" class="java.lang.String"/>
<parameter name="PERIOD2" class="java.lang.String"/>
<parameter name="COMPANY_POID" class="java.lang.String"/>
<!-- COMPANY_POID holds only the first selected company; COMPANY_POID_CSV carries the full multiselect list -->
<parameter name="COMPANY_POID_CSV" class="java.lang.String"/>
<parameter name="COST_POID" class="java.lang.String"/>
<parameter name="LEVEL_LIMIT" class="java.lang.String"/>
<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
<defaultValueExpression><![CDATA["////10.100.100.159//ERP_Reports//Reports//"]]></defaultValueExpression>
</parameter>
<parameter name="SUBREPORT1" class="net.sf.jasperreports.engine.JasperReport"/>
<parameter name="REPORT_DATE" class="java.util.Date"/>
<queryString>
<![CDATA[WITH p AS (
    SELECT string_to_array(translate(CAST($P{COMPANY_POID_CSV} AS TEXT), '{} ', ''), ',')::numeric[] AS poids
)
SELECT CASE
           WHEN 999 = ANY(p.poids) THEN 'All Companies'
           ELSE (
               SELECT string_agg(DISTINCT GCM.COMPANY_NAME, ',' || CHR(10) ORDER BY GCM.COMPANY_NAME)
               FROM GLOBAL_COMPANY_MASTER GCM
               WHERE GCM.COMPANY_POID = ANY(p.poids)
           )
       END AS COMPANY_NAME
FROM p]]>
</queryString>
<field name="COMPANY_NAME" class="java.lang.String"/>

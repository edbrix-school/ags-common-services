<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="BillwiseLedgerStatement" language="groovy" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="e283d998-408e-4292-94c4-1f2bdb88a025">
  <property name="ireport.zoom" value="1.6105100000000032"/>
  <property name="ireport.x" value="0"/>
  <property name="ireport.y" value="0"/>
  <subDataset name="GL_DESC" uuid="e667b798-0503-431d-9911-fefb33d97005">
    <parameter name="GL_POID" class="java.lang.String"/>
    <queryString>
      <![CDATA[SELECT GL_CODE || ' / ' || GL_DESCRIPTION AS GL_DESC, production.FUNC_FOR_GL_ADDRESS($P{GL_POID}::text) AS GL_ADDRESS
FROM GL_MASTER
WHERE GL_POID = $P{GL_POID}::numeric]]>
    </queryString>
    <field name="GL_DESC" class="java.lang.String"/>
    <field name="GL_ADDRESS" class="java.lang.String"/>
  </subDataset>
  <subDataset name="ContactPerson" uuid="6b1d2bfe-50e2-4a88-9c03-00d3fbca3e74">
    <parameter name="company_poid" class="java.lang.String"/>
    <queryString>
      <![CDATA[SELECT COMPANY_CODE || ' / ' || COMPANY_NAME as COMPANY_NAME,CONTACT_PERSON
FROM GLOBAL_COMPANY_MASTER
WHERE (
    999 = ANY(ARRAY[$P{company_poid}]::numeric[])
    OR COMPANY_POID = ANY(ARRAY[$P{company_poid}]::numeric[])
)]]>
    </queryString>
    <field name="COMPANY_NAME" class="java.lang.String"/>
    <field name="CONTACT_PERSON" class="java.lang.String"/>
    <group name="group1">
      <groupExpression><![CDATA[$P{company_poid}]]></groupExpression>
    </group>
  </subDataset>
  <parameter name="SUB_HEADER" class="net.sf.jasperreports.engine.JasperReport"/>
  <parameter name="SUB_FOOTER" class="net.sf.jasperreports.engine.JasperReport"/>
  <parameter name="SUB_CONTACT" class="net.sf.jasperreports.engine.JasperReport"/>
  <parameter name="PERIOD_DATE" class="java.lang.String" isForPrompting="false">
    <defaultValueExpression><![CDATA[]]></defaultValueExpression>
  </parameter>
  <parameter name="GL_POID" class="java.lang.String">
    <defaultValueExpression><![CDATA[]]></defaultValueExpression>
  </parameter>
  <parameter name="COMPANY_POID" class="java.lang.String">
    <defaultValueExpression><![CDATA[]]></defaultValueExpression>
  </parameter>
  <parameter name="COMPANY_POID_CSV" class="java.lang.String"/>
  <parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
    <defaultValueExpression><![CDATA["\\\\10.100.100.159\\ERP_Reports\\Reports\\"]]></defaultValueExpression>
  </parameter>
  <parameter name="PRINT_OPTION" class="java.lang.String"/>
  <parameter name="LOGIN_COMP_POID" class="java.lang.String"/>
  <parameter name="DOC_ID" class="java.lang.String"/>
  <parameter name="AS_ON_DATE" class="java.lang.String"/>
  <parameter name="DR_CR_OPTION" class="java.lang.String"/>
  <parameter name="LINE_POID" class="java.lang.String"/>
  <queryString>
    <![CDATA[SELECT DOC_COMPANY,DOC_COMPANY_NUM,TO_CHAR(DOC_DATE,'YYYY-MM-DD') DOC_DATE, DOC_ID, BILL_REF,  REMARKS, round(BILL_AMT,3)BILL_AMT, DRCR, round(BAL_AMT,3)BAL_AMT, DR_CR, TO_CHAR(DUE_DATE,'YYYY-MM-DD') DUE_DATE,DUE_DATE AS DUE_DATE1, DUE_DAYS
FROM
      (SELECT
                  GLB.GL_COMPANY_POID, GLB.TRANSACTION_DATE DOC_DATE, GLB.DOC_ID,trim(GLB.BILL_REF)BILL_REF, GLB.DOC_REF || ' - ' ||  GLB.REMARKS as REMARKS,
                  CASE WHEN GLB2.BILL_AMT >= 0  THEN GLB2.BILL_AMT ELSE GLB2.BILL_AMT END as  BILL_AMT,
                  CASE WHEN GLB2.BILL_AMT >= 0 THEN 'Dr' ELSE 'Cr' END DRCR,
                  CASE WHEN GLB1.BAL_AMT  >= 0  THEN GLB1.BAL_AMT ELSE GLB1.BAL_AMT END as  BAL_AMT,
                  CASE WHEN GLB1.BAL_AMT  >= 0 THEN 'Dr' ELSE 'Cr' END DR_CR,
                  COALESCE(GLB.BILL_DUE_DATE, GLB.TRANSACTION_DATE) as DUE_DATE,
                  CASE WHEN (TO_DATE($P{AS_ON_DATE},'YYYY-MM-DD') - COALESCE(GLB.BILL_DUE_DATE, GLB.TRANSACTION_DATE)::date + 1) <= 0 THEN NULL
                  ELSE (TO_DATE($P{AS_ON_DATE},'YYYY-MM-DD') - COALESCE(GLB.BILL_DUE_DATE, GLB.TRANSACTION_DATE)::date + 1)::numeric END DUE_DAYS,
                  GET_COMPANY_CODE( COALESCE(Glb.DOC_COMPANY_POID, GLB.GL_COMPANY_POID)) as DOC_COMPANY,
                  case when $P{PRINT_OPTION} = '1' then 1::numeric
                    when $P{PRINT_OPTION} = '2' then COALESCE(Glb.Doc_Company_Poid, GLB.GL_COMPANY_POID)
                    when $P{PRINT_OPTION} = '3' then COALESCE(GLB.GL_COMPANY_POID, GLB.TRANSACTION_COMPANY_POID)
                    end DOC_COMPANY_NUM,
                  ROW_NUMBER() OVER(PARTITION BY GLB.GL_COMPANY_POID, trim(GLB.BILL_REF) ORDER BY  GLB.TRANSACTION_DATE) as RN
            FROM
            GL_LEDGER_BILLWISE_BREAKUP GLB
              INNER JOIN (SELECT
                                GLB.GL_COMPANY_POID, GLB.GL_POID, TRIM(GLB.BILL_REF) BILL_REF,  ROUND(SUM(COALESCE(GLB.DR_AMT,0)) - SUM(COALESCE(GLB.CR_AMT,0)),3) as BAL_AMT
                                FROM GL_LEDGER_BILLWISE_BREAKUP GLB
                                WHERE GLB.TRANSACTION_DATE::date <=  TO_DATE($P{AS_ON_DATE},'YYYY-MM-DD')
                                GROUP BY GLB.GL_COMPANY_POID, GLB.GL_POID, TRIM(GLB.BILL_REF)
                                HAVING   ROUND(SUM(COALESCE(GLB.DR_AMT,0)) - SUM(COALESCE(GLB.CR_AMT,0)),3)  <> 0
                                ) GLB1
              ON GLB.GL_COMPANY_POID = GLB1.GL_COMPANY_POID AND GLB.GL_POID = GLB1.GL_POID AND TRIM(GLB.BILL_REF) = TRIM(GLB1.BILL_REF)
              LEFT JOIN (SELECT
                               GLB.GL_COMPANY_POID, GLB.GL_POID, TRIM(GLB.BILL_REF) BILL_REF,  ROUND(SUM( CASE WHEN COALESCE(DR_AMT,0) <> 0 THEN GLB.DR_AMT ELSE -1 * GLB.CR_AMT END),3) as BILL_AMT
                               FROM GL_LEDGER_BILLWISE_BREAKUP GLB
                               WHERE GLB.TRANSACTION_DATE::date <=  TO_DATE($P{AS_ON_DATE},'YYYY-MM-DD')
                               and Bill_Ref_Type IN ('NEW', 'ON-ACCOUNT')
                               GROUP BY GLB.GL_COMPANY_POID, GLB.GL_POID, trim(GLB.BILL_REF)
                               HAVING   ROUND(SUM(COALESCE(GLB.DR_AMT,0)) - SUM(COALESCE(GLB.CR_AMT,0)),3)  <> 0
                               ) GLB2
              ON GLB.GL_COMPANY_POID = GLB2.GL_COMPANY_POID AND GLB.GL_POID = GLB2.GL_POID AND TRIM(GLB.BILL_REF) = TRIM(GLB2.BILL_REF)
            WHERE Bill_Ref_Type IN ('NEW', 'ON-ACCOUNT')
                  AND GLB.GL_POID = $P{GL_POID}::numeric
                  AND  (COALESCE(GLB.LINE_POID::text,'0') LIKE CASE WHEN COALESCE($P{LINE_POID},'0') IN ('0','NULL') THEN '%' ELSE $P{LINE_POID} END
                        OR COALESCE(GLB.LINE_POID::text,'0') NOT IN (CASE WHEN $P{LINE_POID}='100000' THEN '126' ELSE NULL END))
AND (
    Array[$P{COMPANY_POID_CSV}] IS NULL
    OR 999 = ANY(array[$P{COMPANY_POID_CSV}]::numeric[])
    OR GLB.GL_COMPANY_POID = ANY(array[$P{COMPANY_POID_CSV}]::numeric[])
)
                  AND GLB.TRANSACTION_DATE::date <=  TO_DATE($P{AS_ON_DATE},'YYYY-MM-DD')
                  ORDER BY GLB.GL_POID, COALESCE(GLB.BILL_DUE_DATE, GLB.TRANSACTION_DATE)
      ) sub
      WHERE RN = 1 AND UPPER(DR_CR) LIKE (CASE WHEN $P{DR_CR_OPTION} IS NULL OR $P{DR_CR_OPTION} = 'ALL' THEN '%' ELSE '%'||$P{DR_CR_OPTION}||'%' END)
   ORDER BY  DOC_COMPANY_NUM,DOC_DATE,BILL_REF]]>
  </queryString>
  <field name="DOC_COMPANY" class="java.lang.String"/>
  <field name="DOC_COMPANY_NUM" class="java.math.BigDecimal"/>
  <field name="DOC_DATE" class="java.lang.String"/>
  <field name="DOC_ID" class="java.lang.String"/>
  <field name="BILL_REF" class="java.lang.String"/>
  <field name="REMARKS" class="java.lang.String"/>
  <field name="BILL_AMT" class="java.math.BigDecimal"/>
  <field name="DRCR" class="java.lang.String"/>
  <field name="BAL_AMT" class="java.math.BigDecimal"/>
  <field name="DR_CR" class="java.lang.String"/>
  <field name="DUE_DATE" class="java.lang.String"/>
  <field name="DUE_DATE1" class="java.sql.Timestamp"/>
  <field name="DUE_DAYS" class="java.math.BigDecimal"/>
  <variable name="BILL_AMT_1" class="java.math.BigDecimal" resetType="Group" resetGroup="company" calculation="Sum">
    <variableExpression><![CDATA[$F{BILL_AMT}]]></variableExpression>
  </variable>
  <variable name="BAL_AMT_1" class="java.math.BigDecimal" resetType="Group" resetGroup="company" calculation="Sum">
    <variableExpression><![CDATA[$F{BAL_AMT}]]></variableExpression>
  </variable>
  <variable name="DR_CR_BILL" class="java.lang.String" resetType="Group" resetGroup="company">
    <variableExpression><![CDATA[($V{BILL_AMT_1}.compareTo(BigDecimal.ZERO) >= 0) ? "Dr":"Cr"]]></variableExpression>
  </variable>
  <variable name="DR_CR_BAL" class="java.lang.String">
    <variableExpression><![CDATA[($V{BAL_AMT_1}.compareTo(BigDecimal.ZERO) >= 0) ? "Dr":"Cr"]]></variableExpression>
  </variable>
  <variable name="OverDue_Amt" class="java.math.BigDecimal" resetType="Group" resetGroup="company" calculation="Sum">
    <variableExpression><![CDATA[$F{DUE_DAYS}.compareTo(BigDecimal.ZERO) > BigDecimal.ZERO ? $F{BAL_AMT}:null]]></variableExpression>
  </variable>
  <variable name="DR_CR_Overdue" class="java.lang.String" resetType="Group" resetGroup="company">
    <variableExpression><![CDATA[($V{OverDue_Amt}.compareTo(BigDecimal.ZERO) >= 0) ? "Dr":"Cr"]]></variableExpression>
  </variable>
  <variable name="BILL_AMT_2" class="java.math.BigDecimal" resetType="Group" resetGroup="company" calculation="Sum">
    <variableExpression><![CDATA[$F{BILL_AMT}]]></variableExpression>
    <initialValueExpression><![CDATA[]]></initialValueExpression>
  </variable>

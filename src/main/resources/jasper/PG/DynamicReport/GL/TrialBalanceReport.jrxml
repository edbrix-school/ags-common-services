	<!-- CHANGE: language changed from plsql to sql -->
	<subDataset name="TrialBalance" uuid="dd6b8263-f007-4284-9919-0f7833ca03ff">
		<parameter name="PERIOD_DATE" class="java.lang.String"/>
		<parameter name="PERIOD_DATE2" class="java.lang.String"/>
		<parameter name="COMPANY_POID" class="java.lang.String"/>
		<parameter name="LEVEL_LIMIT" class="java.lang.String"/>
		<!-- CHANGE: EXCLUDE_OPENING added to subDataset (was missing in Oracle JRXML) -->
		<parameter name="EXCLUDE_OPENING" class="java.lang.String"/>
		<!-- CHANGE: language changed from plsql to sql; SP call updated for PostgreSQL -->
		<queryString language="sql">
			<![CDATA[SELECT * FROM fn_gl_ledger_trial_bal_rpt( $P{PERIOD_DATE}::date, $P{PERIOD_DATE2}::date, ARRAY[$P{COMPANY_POID}::numeric], $P{LEVEL_LIMIT}, $P{EXCLUDE_OPENING} )]]>
		</queryString>
		<field name="GL_POID" class="java.lang.String"/>
		<field name="FLVL" class="java.math.BigDecimal"/>
		<field name="GL_CODE" class="java.lang.String"/>
		<field name="DESCRIPTION" class="java.lang.String"/>
		<field name="OPENING_BALANCE_DR" class="java.math.BigDecimal"/>
		<field name="OPENING_BALANCE_CR" class="java.math.BigDecimal"/>
		<field name="DR_AMT" class="java.math.BigDecimal"/>
		<field name="CR_AMT" class="java.math.BigDecimal"/>
		<field name="CLOSING_BALANCE_DR" class="java.math.BigDecimal"/>
		<field name="CLOSING_BALANCE_CR" class="java.math.BigDecimal"/>
	</subDataset>
	<parameter name="PERIOD_DATE" class="java.lang.String"/>
	<parameter name="PERIOD_DATE2" class="java.lang.String"/>
	<parameter name="COMPANY_POID" class="java.lang.String"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["\\\\10.100.100.159\\ERP_Reports\\Reports\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT1" class="net.sf.jasperreports.engine.JasperReport"/>
	<parameter name="LEVEL_LIMIT" class="java.lang.String"/>
	<parameter name="REPORT_DATE" class="java.util.Date"/>
	<!-- CHANGE: EXCLUDE_OPENING added to main report parameters (was missing in Oracle JRXML) -->
	<parameter name="EXCLUDE_OPENING" class="java.lang.String"/>
	<!-- CHANGE: Main query updated - replaced Oracle DECODE() with PostgreSQL CASE WHEN -->
	<queryString>
		<![CDATA[SELECT DISTINCT COMPANY_NAME FROM (
    SELECT
        CASE WHEN $P{COMPANY_POID} = '999' THEN 'All Companies'
             ELSE GCM.COMPANY_NAME
        END AS COMPANY_NAME
    FROM GLOBAL_COMPANY_MASTER GCM
    WHERE CAST($P{COMPANY_POID} AS INTEGER) = 999
       OR GCM.COMPANY_POID = CAST($P{COMPANY_POID} AS INTEGER)
) as subquery]]>
	</queryString>
	<field name="COMPANY_NAME" class="java.lang.String"/>

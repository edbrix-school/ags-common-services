    <subDataset name="Details_Packages" uuid="1ce1c7cb-7ecf-49d7-8403-d4c831581e88">
        <parameter name="DOC_KEY_POID_D" class="java.lang.String" isForPrompting="false"/>
        <parameter name="P_RPT_SELECTED_VALUES_LIST" class="java.lang.String"/>
        <queryString language="sql">
            <![CDATA[SELECT PACK_UNIT PACKAGING, NO_OF_PACKS QUANTITY, NET_WEIGHT WEIGHT_KG, NET_VOLUME VOLUME_CBM, CARGO_DESCRIPTION,
CONCAT(CONTAINER_NO,'/',CONTAINER_SEAL_NO) MARKING_SEAL_NO, UNLOAD_DATE
FROM FF_MANIEST_CONTAINER_DTL
WHERE (transaction_poid = $P{DOC_KEY_POID_D}::numeric
   OR (transaction_poid::text || CONTAINER_NO) IN (SELECT * FROM func_glob_split_string($P{P_RPT_SELECTED_VALUES_LIST}, ','))
)
UNION ALL
SELECT UNIT_PACK PACKAGING, TOTAL_NO_OF_PACKS QUANTITY, TOTAL_WEIGHT WEIGHT_KG, TOTAL_NET_VOLUME VOLUME_CBM, CARGO_DESCRIPTION,
NULL::text AS MARKING_SEAL_NO, NULL::timestamp AS UNLOAD_DATE
FROM FF_MANIEST_HDR
WHERE transaction_poid = $P{DOC_KEY_POID_D}::numeric
  AND upper(FF_JOBTYPE) IN ('AIR_IMP')]]>
        </queryString>
        <field name="PACKAGING" class="java.lang.String"/>
        <field name="QUANTITY" class="java.math.BigDecimal"/>
        <field name="WEIGHT_KG" class="java.math.BigDecimal"/>
        <field name="VOLUME_CBM" class="java.math.BigDecimal"/>
        <field name="CARGO_DESCRIPTION" class="java.lang.String"/>
        <field name="MARKING_SEAL_NO" class="java.lang.String"/>
        <field name="UNLOAD_DATE" class="java.sql.Timestamp"/>
        <variable name="SUM_QUANTITY" class="java.lang.Number" calculation="Sum">
            <variableExpression><![CDATA[$F{QUANTITY}]]></variableExpression>
        </variable>
        <variable name="SUM_WEIGHT" class="java.lang.Number" calculation="Sum">
            <variableExpression><![CDATA[$F{WEIGHT_KG}]]></variableExpression>
        </variable>
        <variable name="SUM_VOLUME" class="java.lang.Number" calculation="Sum">
            <variableExpression><![CDATA[$F{VOLUME_CBM}]]></variableExpression>
        </variable>
    </subDataset>
    <parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
        <defaultValueExpression><![CDATA["\\\\10.100.100.3\\ERP_REPORTS\\Reports\\"]]></defaultValueExpression>
    </parameter>
    <parameter name="P_REP_FOOTER" class="java.lang.String" isForPrompting="false">
        <parameterDescription><![CDATA[ENTER FOOTER DATA IN PARAMETER]]></parameterDescription>
    </parameter>
    <parameter name="DOC_KEY_POID" class="java.lang.String"/>
    <parameter name="LOGIN_DIV_POID" class="java.lang.String" isForPrompting="false">
        <defaultValueExpression><![CDATA[3]]></defaultValueExpression>
    </parameter>
    <parameter name="LOGIN_COMP_POID" class="java.lang.String">
        <defaultValueExpression><![CDATA[1]]></defaultValueExpression>
    </parameter>
    <parameter name="DOC_ID" class="java.lang.String" isForPrompting="false">
        <defaultValueExpression><![CDATA["000-000"]]></defaultValueExpression>
    </parameter>
    <parameter name="LOGIN_USER_POID" class="java.lang.String" isForPrompting="false"/>
    <parameter name="P_RPT_SELECTED_VALUES_LIST" class="java.lang.String"/>
    <parameter name="SUB_HEADER" class="net.sf.jasperreports.engine.JasperReport"/>
    <queryString language="sql">
        <![CDATA[SELECT
  CONCAT(TO_CHAR(DELIVERY_DATE_FROM,'DD-Mon-YYYY/HH24:MI'), '-', TO_CHAR(DELIVERY_DATE_TO,' HH24:MI')) AS PLANNED_DELIVERY_DATE_TIME,
  CONCAT(RELEASED_TYPE,' RELEASE') AS RELEASED_TYPE,
  GET_COMPANY_NAME(m.COMPANY_POID) AS COMPANY,
  TRANSACTION_POID,
  FF_JOBNO,
  CONSIGNEE_POID,
  NULL AS CUST_REF_NO,
  CARGO_DESCRIPTION AS COMMMODITY,
  CASE WHEN SUBSTR(FF_JOBTYPE,1,2) IN ('RD','CU','CF') THEN 'OTHER'
       ELSE COALESCE(CONSIGNMENT_TYPE,'AIR')
  END AS SHIPMENT_TYPE,
  MASTER_BL_NO AS OBL_NO,
  HOUSE_BL_NO AS HBL_NO,
  COALESCE(
      GET_PORT_NAME(FEEDER_LOADPORT_POID),
      CASE WHEN GET_AIRPORT_NAME(AWPORT_OF_LOAD) = 'N/A' THEN AWPORT_OF_LOAD
           ELSE GET_AIRPORT_NAME(AWPORT_OF_LOAD)
      END
  ) AS PORT_OF_LOADING,
  COALESCE(GET_PORT_NAME(FEEDER_UNLOADPORT_POID), GET_AIRPORT_NAME(AIR_ARRIVAL_PORT)) AS PORT_OF_DISCHARGE,
  NULL AS PERMIT_NO,
  CONCAT(MOTHER_VSL_NAME,'/',COALESCE(MOTHER_VSL_VOYAGENO,FLIGHT_NO)) AS VESSEL_VOYAGE,
  CONCAT(FEEDER_VSL_NAME,'/',FEEDER_VOYAGE_NO) AS FEEDER_VESSEL_VOYAGE,
  COALESCE(FEEDER_VSL_ARRIVAL_DATE, FLIGHT_DATE) AS ETA,
  CASE WHEN COALESCE(GA.ADDRESS_NAME,'XXX') = 'XXX' THEN CONSIGNE_MANUAL
       ELSE CONCAT(GA.ADDRESS_NAME, CHR(10), GA.ADDRESS_NAME2)
  END AS CONSIGNE_NAME,
  COALESCE(GA1.PO_BOX,'') AS PO_BOX,
  COALESCE(GA1.BLDG,'') AS BUILDING,
  COALESCE(GA1.STATE,'') AS STATE,
  COALESCE(GA1.EMAIL1,'') AS EMAIL,
  COALESCE(GA1.FAX,'') AS FAX,
  COALESCE(GA1.OFF_TEL1,'') AS OFFICE_TEL,
  COALESCE(GA1.MOBILE,'') AS MOBILE,
  CONCAT(SM.SALESMAN_NAME,' - ',SM.MOBILE) AS POC,
  CASE WHEN GET_AIRLINE_NAME(CARRIER_CODE) = 'N/A' THEN GET_LINE_NAME(LINE_POID)
       ELSE GET_AIRLINE_NAME(CARRIER_CODE)
  END AS CARRIER,
  FCR_SUPLIER_SHIPPER_REF
FROM FF_MANIEST_HDR m
LEFT JOIN GLOBAL_ADDRESS_DETAILS GA1
  ON m.CONSIGNEE_POID = GA1.ADDRESS_POID AND GA1.ADDRESS_TYPE IN ('CAN')
LEFT JOIN GLOBAL_ADDRESS_MASTER GA
  ON GA1.ADDRESS_MASTER_POID = GA.ADDRESS_MASTER_POID
LEFT JOIN SALES_SALESMAN_MASTER SM
  ON M.SALESMAN_POID = SM.SALESMAN_POID
WHERE (
    TRANSACTION_POID = $P{DOC_KEY_POID}::numeric
    OR TRANSACTION_POID IN (
        SELECT TRANSACTION_POID
        FROM FF_MANIEST_CONTAINER_DTL
        WHERE (transaction_poid::text || CONTAINER_NO) IN (
            SELECT * FROM func_glob_split_string($P{P_RPT_SELECTED_VALUES_LIST}, ',')
        )
    )
)
AND (
    upper(FF_JOBTYPE) IN ('AIR_IMP','SEA_IMP','CF_JOB','FF_PRO')
    OR SUBSTR(upper(FF_JOBTYPE),1,2) IN ('CF','RD','CU')
)]]>
    </queryString>
    <field name="PLANNED_DELIVERY_DATE_TIME" class="java.lang.String"/>
    <field name="RELEASED_TYPE" class="java.lang.String"/>
    <field name="COMPANY" class="java.lang.String"/>
    <field name="TRANSACTION_POID" class="java.math.BigDecimal"/>
    <field name="FF_JOBNO" class="java.lang.String"/>
    <field name="CONSIGNEE_POID" class="java.math.BigDecimal"/>
    <field name="CUST_REF_NO" class="java.lang.String"/>
    <field name="COMMMODITY" class="java.lang.String"/>
    <field name="SHIPMENT_TYPE" class="java.lang.String"/>
    <field name="OBL_NO" class="java.lang.String"/>
    <field name="HBL_NO" class="java.lang.String"/>
    <field name="PORT_OF_LOADING" class="java.lang.String"/>
    <field name="PORT_OF_DISCHARGE" class="java.lang.String"/>
    <field name="PERMIT_NO" class="java.lang.String"/>
    <field name="VESSEL_VOYAGE" class="java.lang.String"/>
    <field name="FEEDER_VESSEL_VOYAGE" class="java.lang.String"/>
    <field name="ETA" class="java.sql.Timestamp"/>
    <field name="CONSIGNE_NAME" class="java.lang.String"/>
    <field name="PO_BOX" class="java.lang.String"/>
    <field name="BUILDING" class="java.lang.String"/>
    <field name="STATE" class="java.lang.String"/>
    <field name="EMAIL" class="java.lang.String"/>
    <field name="FAX" class="java.lang.String"/>
    <field name="OFFICE_TEL" class="java.lang.String"/>
    <field name="MOBILE" class="java.lang.String"/>
    <field name="POC" class="java.lang.String"/>
    <field name="CARRIER" class="java.lang.String"/>
    <field name="FCR_SUPLIER_SHIPPER_REF" class="java.lang.String"/>
    <variable name="ConsigneAddress" class="java.lang.String" resetType="Page">
        <initialValueExpression><![CDATA[(($F{CONSIGNE_NAME}== null ? "":$F{CONSIGNE_NAME}) + "\n" +"Email :" +($F{EMAIL}== null ? "":$F{EMAIL})+"\n"+ "Contact# :" +($F{OFFICE_TEL} == null ? "" :$F{OFFICE_TEL}+"/")+($F{MOBILE} == null ?"" :$F{MOBILE}+",Fax :" +($F{FAX} == null ? "":$F{FAX})))]]></initialValueExpression>
    </variable>

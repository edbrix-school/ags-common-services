    <queryString language="sql">
    <![CDATA[SELECT ROW_NUMBER() OVER () AS SL,
MNF.TRANSACTION_POID,
MNF.TRANSACTION_DATE,
MNF.COMPANY_POID, COMP.COMPANY_NAME, COMP.ADDRESS,
MNF.DOC_REF AS FF_JOBNO,
CONCAT(MNF.FF_JOBTYPE, ' ', 'MANIFEST') AS BL_TYPE,
get_line_name(MHDR.LINE_POID) AS LINE,
MHDR.PRINCIPAL_POID, MASTER_BL_NO,
HOUSEBL_NO AS HOUSE_BL_NO, FEEDER_VOYAGE_NO, FEEDER_VSL_NAME,
FEEDER_VSL_SAIL_DATE, FEEDER_VSL_ETA, FEEDER_VSL_ARRIVAL_DATE,
get_port_name(MNF.PORT_OF_LOAD) AS LOAD_PORT,
get_port_name(MNF.PORT_OF_DISCHARGE) AS UNLOAD_PORT,
MNF.FF_JOBTYPE, MNF.DOC_REF,
COALESCE(GA1.ADDRESS_NAME,'') AS SHIPPER_NAME,
COALESCE(SHPR.PO_BOX,'') AS S_PO_BOX,
COALESCE(SHPR.BLDG,'') AS S_BUILDING,
COALESCE(SHPR.STATE,'') AS S_STATE,
COALESCE(SHPR.EMAIL1,'') AS S_EMAIL,
COALESCE(SHPR.FAX,'') AS S_FAX,
COALESCE(SHPR.OFF_TEL1,'') AS S_OFFICE_TEL,
COALESCE(SHPR.MOBILE,'') AS S_MOBILE,
COALESCE(SHPR.LAND_MARK,'') AS S_SHORT_ADDR,
COALESCE(GA2.ADDRESS_NAME,'') AS CONSINEE_NAME,
COALESCE(CON.PO_BOX,'') AS C_PO_BOX,
COALESCE(CON.BLDG,'') AS C_BUILDING,
COALESCE(CON.STATE,'') AS C_STATE,
COALESCE(CON.EMAIL1,'') AS C_EMAIL,
COALESCE(CON.FAX,'') AS C_FAX,
COALESCE(CON.OFF_TEL1,'') AS C_OFFICE_TEL,
COALESCE(CON.MOBILE,'') AS C_MOBILE,
COALESCE(CON.LAND_MARK,'') AS C_SHORT_ADDR,
MNF.NOTIFY_MANUAL AS NOTIFY_NAME,
NULL::text AS N_PO_BOX,
NULL::text AS N_BUILDING,
NULL::text AS N_STATE,
NULL::text AS N_EMAIL,
NULL::text AS N_FAX,
NULL::text AS N_OFFICE_TEL,
NULL::text AS N_MOBILE,
NULL::text AS N_SHORT_ADDR,
CARGO_DETAILS AS CARGO_DESCRIPTION,
NULL::text AS MARK_NUMBERS,
NULL::text AS TOTAL_NET_VOLUME,
HSBL_WEIGHT AS TOTAL_NET_WEIGHT,
MNF.SHIPPER_MANUAL, MNF.CONSIGNE_MANUAL, MNF.NOTIFY_MANUAL,
NULL::text AS OFOQ_MNF_REF,
NOOF_PACK, MNF.HANDLING_INFO
FROM FF_HOUSEBL_HDR MNF
INNER JOIN FF_MANIEST_HDR MHDR ON MNF.MASTERBL_POID = MHDR.TRANSACTION_POID
INNER JOIN GLOBAL_COMPANY_MASTER COMP ON MNF.COMPANY_POID = COMP.COMPANY_POID
LEFT JOIN GLOBAL_ADDRESS_DETAILS SHPR ON MNF.SHIPPER_POID = SHPR.ADDRESS_POID AND SHPR.ADDRESS_TYPE = 'MAIN'
LEFT JOIN GLOBAL_ADDRESS_MASTER GA1 ON SHPR.ADDRESS_MASTER_POID = GA1.ADDRESS_MASTER_POID
LEFT JOIN GLOBAL_ADDRESS_DETAILS CON ON MNF.CONSIGNEE_POID = CON.ADDRESS_POID AND CON.ADDRESS_TYPE = 'MAIN'
LEFT JOIN GLOBAL_ADDRESS_MASTER GA2 ON CON.ADDRESS_MASTER_POID = GA2.ADDRESS_MASTER_POID
WHERE MNF.TRANSACTION_POID IN (SELECT HBL_DOC_POID FROM FF_MULTIPLE_MANIFEST_RPT)]]>
    </queryString>

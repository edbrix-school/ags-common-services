    <variable name="SHIPPER" class="java.lang.String">
    <variableExpression><![CDATA[($F{SHIPPER_NAME}+ "\n" +($F{S_PO_BOX} == null? "":"P. O. BOX :"+$F{S_PO_BOX}) + "\n" + ($F{S_EMAIL}== null ? "":"Email :" +$F{S_EMAIL})+"\n"+"Contact# :" + ($F{S_OFFICE_TEL} == null ? "" :$F{S_OFFICE_TEL}+"/")+($F{S_SHORT_ADDR} == null ?"" :$F{S_SHORT_ADDR}  ))]]></variableExpression>
    <initialValueExpression><![CDATA[]]></initialValueExpression>
    </variable>
    <variable name="CONSIGNEE" class="java.lang.String">
    <initialValueExpression><![CDATA[($F{CONSINEE_NAME}+ "\n" +($F{C_PO_BOX} == null? "":"P. O. BOX :"+$F{C_PO_BOX}) + "\n" + ($F{C_EMAIL}== null ? "":"Email :" +$F{C_EMAIL})+"\n"+"Contact# :" + ($F{C_OFFICE_TEL} == null ? "" :$F{C_OFFICE_TEL}+"/")+($F{C_MOBILE} == null ?"" :$F{C_MOBILE}+",Fax :" +($F{C_FAX} == null ? "":$F{C_FAX}) ))]]></initialValueExpression>
    </variable>
    <variable name="NOTIFY" class="java.lang.String">
    <variableExpression><![CDATA[($F{NOTIFY_NAME}+ "\n" +($F{N_PO_BOX} == null? "":"P. O. BOX :"+$F{N_PO_BOX}) + "\n" + ($F{N_EMAIL}== null ? "":"Email :" +$F{N_EMAIL})+"\n"+"Contact# :" + ($F{N_OFFICE_TEL} == null ? "" :$F{N_OFFICE_TEL}+"/")+($F{N_MOBILE} == null ?"" :$F{N_MOBILE}+",Fax :" +($F{N_FAX} == null ? "":$F{N_FAX}) ))]]></variableExpression>
    <initialValueExpression><![CDATA[]]></initialValueExpression>
    </variable>

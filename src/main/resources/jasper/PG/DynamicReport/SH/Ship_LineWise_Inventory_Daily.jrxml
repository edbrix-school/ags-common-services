	<style name="Crosstab Data Text" hAlign="Center"/>
	<subDataset name="FULL" uuid="f93ca439-e71e-44c6-9dfb-2502a5d2dfc1">
		<queryString>
			<![CDATA[select vwinvt.MAINFEST_TRANSACTION_POID,SLM.LINE_NAME,shcntdtl.CONTAINER_NO,shcntdtl.EQUIPMENT_ISO_TYPE
,vwinvt.DISCHARGE_FULL from VW_CONTAINER_MOVES_INVENTORY vwinvt
inner join SHIP_BL_MANIFEST_CONTAINER_DTL shcntdtl on vwinvt.MAINFEST_TRANSACTION_POID=shcntdtl.TRANSACTION_POID
AND shcntdtl.CONTAINER_NO=vwinvt.CONTAINER_NO
INNER JOIN SHIP_LINE_MASTER SLM ON vwinvt.LINE_POID=SLM.LINE_POID
where  vwinvt.DISCHARGE_FULL is not null and vwinvt.EMPTY_IN is null and vwinvt.WITH_CONSIGNEE_FULL is null
AND vwinvt.DISCHARGE_FULL>='01-JAN-2016']]>
		</queryString>
		<field name="MAINFEST_TRANSACTION_POID" class="java.math.BigDecimal"/>
		<field name="LINE_NAME" class="java.lang.String"/>
		<field name="CONTAINER_NO" class="java.lang.String"/>
		<field name="EQUIPMENT_ISO_TYPE" class="java.lang.String"/>
	</subDataset>
	<subDataset name="EMPTY" uuid="f6a00d19-0b98-4656-9bfa-f966fb7f3f9e">
		<queryString language="SQL">
			<![CDATA[select vwinvt.MAINFEST_TRANSACTION_POID,SLM.LINE_NAME,shcntdtl.CONTAINER_NO,shcntdtl.EQUIPMENT_ISO_TYPE,vwinvt.EMPTY_IN
from VW_CONTAINER_MOVES_INVENTORY vwinvt
inner join SHIP_BL_MANIFEST_CONTAINER_DTL shcntdtl on vwinvt.MAINFEST_TRANSACTION_POID=shcntdtl.TRANSACTION_POID
AND shcntdtl.CONTAINER_NO=vwinvt.CONTAINER_NO
INNER JOIN SHIP_LINE_MASTER SLM ON vwinvt.LINE_POID=SLM.LINE_POID
where  vwinvt.DISCHARGE_FULL is not null and vwinvt.EMPTY_IN is not null and vwinvt.EMPTY_OUT is null
AND vwinvt.DISCHARGE_FULL>='01-JAN-2016']]>
		</queryString>
		<field name="MAINFEST_TRANSACTION_POID" class="java.math.BigDecimal"/>
		<field name="LINE_NAME" class="java.lang.String"/>
		<field name="CONTAINER_NO" class="java.lang.String"/>
		<field name="EQUIPMENT_ISO_TYPE" class="java.lang.String"/>
		<field name="EMPTY_IN" class="oracle.sql.TIMESTAMP"/>
	</subDataset>
	<subDataset name="CONSIGNEE" uuid="3d0b4571-4afe-4c5d-8def-33ce5eae7ead">
		<queryString>
			<![CDATA[select vwinvt.MAINFEST_TRANSACTION_POID,SLM.LINE_NAME,shcntdtl.CONTAINER_NO,shcntdtl.EQUIPMENT_ISO_TYPE,
vwinvt.WITH_CONSIGNEE_FULL from VW_CONTAINER_MOVES_INVENTORY vwinvt
inner join SHIP_BL_MANIFEST_CONTAINER_DTL shcntdtl on vwinvt.MAINFEST_TRANSACTION_POID=shcntdtl.TRANSACTION_POID
AND shcntdtl.CONTAINER_NO=vwinvt.CONTAINER_NO
INNER JOIN SHIP_LINE_MASTER SLM ON vwinvt.LINE_POID=SLM.LINE_POID
where  vwinvt.DISCHARGE_FULL is not null and vwinvt.EMPTY_IN is   null and vwinvt.WITH_CONSIGNEE_FULL is not null
AND vwinvt.DISCHARGE_FULL>='01-JAN-2016']]>
		</queryString>
		<field name="MAINFEST_TRANSACTION_POID" class="java.math.BigDecimal"/>
		<field name="LINE_NAME" class="java.lang.String"/>
		<field name="CONTAINER_NO" class="java.lang.String"/>
		<field name="EQUIPMENT_ISO_TYPE" class="java.lang.String"/>
	</subDataset>
	<subDataset name="SHIPPER" uuid="2a5153f3-0006-424c-97a4-95bd2b8920ef">
		<queryString language="SQL">
			<![CDATA[select vwinvt.MAINFEST_TRANSACTION_POID,SLM.LINE_NAME,shcntdtl.CONTAINER_NO,shcntdtl.EQUIPMENT_ISO_TYPE,
vwinvt.EXPORT_PORT_FULL,
(TRUNC(sysdate)-TRUNC(vwinvt.EMPTY_OUT))days from VW_CONTAINER_MOVES_INVENTORY vwinvt
inner join SHIP_BL_MANIFEST_CONTAINER_DTL shcntdtl on vwinvt.MAINFEST_TRANSACTION_POID=shcntdtl.TRANSACTION_POID
AND shcntdtl.CONTAINER_NO=vwinvt.CONTAINER_NO
INNER JOIN SHIP_LINE_MASTER SLM ON vwinvt.LINE_POID=SLM.LINE_POID
where  vwinvt.EMPTY_OUT is not null and vwinvt.EXPORT_PORT_FULL is null AND vwinvt.DISCHARGE_FULL>='01-JAN-2016']]>
		</queryString>
		<field name="MAINFEST_TRANSACTION_POID" class="java.math.BigDecimal"/>
		<field name="LINE_NAME" class="java.lang.String"/>
		<field name="CONTAINER_NO" class="java.lang.String"/>
		<field name="EQUIPMENT_ISO_TYPE" class="java.lang.String"/>
		<field name="EXPORT_PORT_FULL" class="oracle.sql.TIMESTAMP"/>
		<field name="DAYS" class="java.math.BigDecimal"/>
	</subDataset>
	<subDataset name="EXPORT_FULL_GATE" uuid="01149281-91d7-42ab-9adb-ae140e44f810">
		<queryString language="SQL">
			<![CDATA[select MAINFEST_TRANSACTION_POID,SLM.LINE_NAME,shcntdtl.CONTAINER_NO,shcntdtl.EQUIPMENT_ISO_TYPE,
(TRUNC(sysdate)-TRUNC(vwinvt.EXPORT_PORT_FULL))days from VW_CONTAINER_MOVES_INVENTORY vwinvt
inner join SHIP_BL_MANIFEST_CONTAINER_DTL shcntdtl on vwinvt.MAINFEST_TRANSACTION_POID=shcntdtl.TRANSACTION_POID
INNER JOIN SHIP_LINE_MASTER SLM ON vwinvt.LINE_POID=SLM.LINE_POID
where  EMPTY_OUT is not null and EXPORT_PORT_FULL is not null and LOAD_FULL is null AND DISCHARGE_FULL>='01-JAN-2016']]>
		</queryString>
		<field name="MAINFEST_TRANSACTION_POID" class="java.math.BigDecimal"/>
		<field name="LINE_NAME" class="java.lang.String"/>
		<field name="CONTAINER_NO" class="java.lang.String"/>
		<field name="EQUIPMENT_ISO_TYPE" class="java.lang.String"/>
		<field name="DAYS" class="java.math.BigDecimal"/>
	</subDataset>
	<queryString>
		<![CDATA[select 1 AS "1"]]>
	</queryString>
	<field name="1" class="java.math.BigDecimal"/>

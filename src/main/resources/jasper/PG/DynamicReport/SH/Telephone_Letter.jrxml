	<subDataset name="COMPANY_LOG" uuid="58fa9fd2-59c4-44b7-87f9-810d102e5728">
		<parameter name="LOGIN_COMP_POID_L" class="java.lang.String" isForPrompting="false"/>
		<parameter name="LOGIN_DIV_POID_L" class="java.lang.String" isForPrompting="false"/>
		<queryString language="sql">
			<![CDATA[SELECT
    CM.COMPANY_POID AS "COMPANY_POID",
    CM.COMPANY_NAME AS "COMPANY_NAME",
    CM.ADDRESS AS "ADDRESS",
    CM.LOGO_IMAGE AS "LOGO_IMAGE",
    CMD.REMARKS AS "REMARKS",
    CMD.COMPANY_DIV_LOGO AS "COMPANY_DIV_LOGO",
    CMD.COMPANY_DIV_ADDRESS AS "COMPANY_DIV_ADDRESS"
FROM GLOBAL_COMPANY_MASTER CM
INNER JOIN GLOBAL_COMPANY_MASTER_DIV_DTL CMD ON CM.COMPANY_POID = CMD.COMPANY_POID
WHERE CM.COMPANY_POID = CAST($P{LOGIN_COMP_POID_L} AS numeric)
AND CMD.DIV_POID = CAST($P{LOGIN_DIV_POID_L} AS numeric)]]>
		</queryString>
		<field name="COMPANY_POID" class="java.math.BigDecimal"/>
		<field name="COMPANY_NAME" class="java.lang.String"/>
		<field name="ADDRESS" class="java.lang.String"/>
		<field name="LOGO_IMAGE" class="java.io.InputStream"/>
		<field name="REMARKS" class="java.lang.String"/>
		<field name="COMPANY_DIV_LOGO" class="java.io.InputStream"/>
		<field name="COMPANY_DIV_ADDRESS" class="java.lang.String"/>
	</subDataset>
	<parameter name="DOC_KEY_POID" class="java.lang.String" isForPrompting="false"/>
	<parameter name="LOGIN_GROUP_POID" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[1]]></defaultValueExpression>
	</parameter>
	<parameter name="LOGIN_COMP_POID" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[1]]></defaultValueExpression>
	</parameter>
	<parameter name="LOGIN_USER_POID" class="java.lang.String" isForPrompting="false"/>
	<parameter name="DOC_ID" class="java.lang.String" isForPrompting="false"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["\\\\shippingbahrain.com\\data\\ERP_REPORTS\\Reports\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="P_RPT_SELECTED_VALUES_LIST" class="java.lang.String"/>
	<queryString language="sql">
		<![CDATA[SELECT
    TO_CHAR(CURRENT_TIMESTAMP, 'DD Month YYYY') AS "LSYSDATE",
    CURRENT_TIMESTAMP AS "SYSDATE",
    1 AS "DOCUMENT_COMPANY_POID",
    1 AS "DOCUMENT_COMPANY_DIVISION_POID",
    TELEPHONE_POID AS "TELEPHONE_POID",
    'Mobile No. - ' || TELEPHONE_NUMBER AS "TELEPHONE_NUMBER",
    DESCRIPTION AS "DESCRIPTION"
FROM ADMIN_TELEPHONES_MASTER
WHERE COALESCE(ACTIVE,'Y') = 'Y'
AND TELEPHONE_POID IN (SELECT unnest(string_to_array($P{P_RPT_SELECTED_VALUES_LIST}, ',')::numeric[]))]]>
	</queryString>
	<field name="LSYSDATE" class="java.lang.String"/>
	<field name="SYSDATE" class="java.sql.Timestamp"/>
	<field name="DOCUMENT_COMPANY_POID" class="java.math.BigDecimal"/>
	<field name="DOCUMENT_COMPANY_DIVISION_POID" class="java.math.BigDecimal"/>
	<field name="TELEPHONE_POID" class="java.math.BigDecimal"/>
	<field name="TELEPHONE_NUMBER" class="java.lang.String"/>
	<field name="DESCRIPTION" class="java.lang.String"/>

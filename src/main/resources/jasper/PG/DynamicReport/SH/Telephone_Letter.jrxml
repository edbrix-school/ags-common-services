				</textElement>
				<text><![CDATA[>>]]></text>
			</staticText>
			<staticText>
				<reportElement x="72" y="201" width="448" height="32" uuid="780f0395-aca0-447a-827c-cd313aa02c58"/>
				<textElement>
					<font fontName="SansSerif"/>
				</textElement>
				<text><![CDATA[Viacloud services to be used for making international calls.
Batelco services can be used only if Viacloud is not working for making overseas calls.]]></text>
			</staticText>

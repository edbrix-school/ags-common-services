				</textElement>
				<text><![CDATA[>>]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="162" width="70" height="20" uuid="aac84023-1ebb-4763-a0be-02ec5a07f6e1"/>
				<textElement textAlignment="Center">
					<font fontName="SansSerif" isBold="true"/>
				</textElement>
				<text><![CDATA[>>]]></text>
			</staticText>
			<staticText>
				<reportElement x="72" y="162" width="448" height="32" uuid="e75d6022-7eb7-49bd-8fdf-5a824e0c827c"/>
				<textElement>
					<font fontName="SansSerif"/>
				</textElement>
				<text><![CDATA[I will not register any payment apps using company mobile number in future as well.
If needed shall use only my personal number for any payment apps.]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="201" width="70" height="20" uuid="0a502006-38cf-476c-a803-8e2f62e02414"/>

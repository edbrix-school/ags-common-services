				<textElement>
					<font fontName="SansSerif"/>
				</textElement>
				<text><![CDATA[During Vacation :]]></text>
			</staticText>
			<staticText>
				<reportElement x="98" y="260" width="422" height="18" uuid="707a6ec9-a9fd-4e65-bc2c-9a2a3f37db02"/>
				<textElement>
					<font fontName="SansSerif"/>
				</textElement>
				<text><![CDATA[Shall not use Data Roaming facility.]]></text>

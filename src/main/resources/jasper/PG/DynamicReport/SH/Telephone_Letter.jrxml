				<textElement>
					<font fontName="SansSerif"/>
				</textElement>
				<text><![CDATA[No payment Apps registered on the above referred official company mobile number.
(Such as Benefit Pay, STC Pay, BFC Pay, Sadad Pay, Beyon Money, ILA Bank, etc…)]]></text>
			</staticText>
			<staticText>

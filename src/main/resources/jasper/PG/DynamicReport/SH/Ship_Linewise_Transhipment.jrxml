<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Ship_Linewise_Transhipment" language="groovy" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="a74b64c5-8d26-4e11-ac9e-1dc39ff84ac4">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<style name="Crosstab Data Text" hAlign="Center"/>
	<subDataset name="ImportFull" uuid="9fc63432-a77d-48ab-9a59-ba58614ec68b">
		<parameter name="PERIOD_DATE" class="java.lang.String"/>
		<parameter name="PERIOD_DATE2" class="java.lang.String"/>
		<parameter name="DOC_KEY_POID" class="java.lang.String"/>
		<queryString>
			<![CDATA[SELECT LINEMAST.LINE_NAME,VESSEL_NAME,TO_CHAR(NVL(EXPECTED_DATE,ARRIVAL_DATE),'DD-MON-YYYY')                  ARRIVAL_DATE,CONTAINER_TYPE,CONTAINER_NO FROM
        SHIP_VOYAGE_HDR SHVHDR
        INNER JOIN SHIP_VOYAGE_TRANSHIP_DTL SHVTRDT ON SHVHDR.TRANSACTION_POID=SHVTRDT.TRANSACTION_POID
        LEFT JOIN SHIP_LINE_MASTER LINEMAST
        ON SHVHDR.LINE_POID = LINEMAST.LINE_POID
        LEFT JOIN SHIP_VESSEL_MASTER VESSELMAST
        ON SHVHDR.VESSEL_POID = VESSELMAST.VESSEL_POID
        WHERE SHVTRDT.CTP_EMPTY_FULL = 'F' AND NVL(LOAD_TRANSACTION_POID,'1') <>0
        AND
        (
         SHVTRDT.TRANSACTION_POID =$P{DOC_KEY_POID}
OR
        (NVL(EXPECTED_DATE,ARRIVAL_DATE) BETWEEN TO_DATE($P{PERIOD_DATE},'DD-MON-RRRR') AND  TO_DATE($P{PERIOD_DATE2},'DD-MON-RRRR'))
        )]]>
		</queryString>
		<field name="LINE_NAME" class="java.lang.String"/>
		<field name="VESSEL_NAME" class="java.lang.String"/>
		<field name="ARRIVAL_DATE" class="java.lang.String"/>
		<field name="CONTAINER_TYPE" class="java.lang.String"/>
		<field name="CONTAINER_NO" class="java.lang.String"/>
	</subDataset>

<subDataset name="Export_Daybook_Monthly" uuid="046d0e0c-bcbf-4509-a434-f6e5aa2e5c5d">
<queryString>
<![CDATA[SELECT MONTH_YEAR, NO_OF_BLS::numeric(20,0), FT_20::numeric(20,0), FT_40::numeric(20,0), FT_TUES::numeric(20,0), 
PRV_NO_OF_BLS::numeric(20,0), PRV_FT_20::numeric(20,0), PRV_FT_40::numeric(20,0), PRV_FT_TUES::numeric(20,0), VAR_NO_OF_BLS::numeric(20,0), 
VAR_FT_20::numeric(20,0), VAR_FT_40::numeric(20,0), VAR_FT_TUES::numeric(20,0), "var_no_of_bls_%"::numeric(15,0) AS "VAR_NO_OF_BLS_%", 
"var_ft_20_%"::numeric(15,0) AS "VAR_FT_20_%", "var_ft_40_%"::numeric(15,0) AS "VAR_FT_40_%", "var_ft_tues_%"::numeric(15,0) AS "VAR_FT_TUES_%"
FROM SHIP_BL_DAY_BOOK_TEMP_HOLD]]>
</queryString>

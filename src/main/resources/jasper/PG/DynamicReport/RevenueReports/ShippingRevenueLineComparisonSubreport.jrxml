  <queryString language="sql">
    <![CDATA[
SELECT *
FROM fn_sh_rev_line_compar_print(
    ('{' || TRANSLATE(CAST($P{COMPANY_POID_CSV} AS TEXT), '[] ', '') || '}')::numeric[],
    $P{PERIOD}::date,
    $P{PERIOD2}::date,
    $P{OTHER_INCOME},
    $P{LINE},
    $P{PARTY_POID},
    $P{SALESMAN_POID}
)]]>
  </queryString>

  <parameter name="SUBREPORT1" class="net.sf.jasperreports.engine.JasperReport"/>
  <parameter name="OTHER_INCOME" class="java.lang.String"/>
  <parameter name="THIRD_PERIOD_YEAR" class="java.lang.String"/>
  <parameter name="REPORT_DATE" class="java.util.Date"/>
  <queryString language="SQL">
    <![CDATA[WITH poids AS (
    SELECT ('{' || TRANSLATE(CAST($P{COMPANY_POID_CSV} AS TEXT), '[] ', '') || '}')::numeric[] AS ids
)
SELECT
    CASE
        WHEN 999 = ANY(p.ids) THEN 'All Companies'
        ELSE (
            SELECT STRING_AGG(DISTINCT GCM.COMPANY_NAME, ',' || CHR(10) ORDER BY GCM.COMPANY_NAME)
            FROM global_company_master GCM
            WHERE GCM.company_poid = ANY(p.ids)
        )
    END AS COMPANY_NAME,
    CASE
        WHEN $P{OTHER_INCOME}='Y' AND $P{PROFIT_TYPE}='GROSS_PROFIT' THEN 'Included'
        WHEN $P{PROFIT_TYPE}='NET_PROFIT' THEN 'Included'
        ELSE 'Excluded'
    END AS OTHER_INCOME,
    TO_CHAR(CAST($P{PERIOD} AS DATE), 'YYYY') AS CURRENT_YEAR_COLUMN,
    TO_CHAR((EXTRACT(YEAR FROM CAST($P{PERIOD} AS DATE)) - 1)::INT, 'FM9999') AS PREVIOUS_YEAR_COLUMN,
    $P{THIRD_PERIOD_YEAR}::text AS COMPARISON_YEAR_COLUMN
FROM poids p]]>
  </queryString>
  <field name="COMPANY_NAME" class="java.lang.String"/>
  <field name="OTHER_INCOME" class="java.lang.String"/>
  <field name="CURRENT_YEAR_COLUMN" class="java.lang.String"/>
  <field name="PREVIOUS_YEAR_COLUMN" class="java.lang.String"/>
  <field name="COMPARISON_YEAR_COLUMN" class="java.lang.String"/>

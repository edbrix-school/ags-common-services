<subDataset name="RentSummary" uuid="59e0170a-16b4-4d40-ad66-d9f863d14560">
	<parameter name="COMPANY_POID" class="java.lang.String"/>
	<parameter name="PERIOD" class="java.lang.String"/>
	<parameter name="PERIOD2" class="java.lang.String"/>
	<parameter name="LEVEL_LIMIT" class="java.lang.String"/>
	<parameter name="PROFIT_TYPE" class="java.lang.String"/>
	<!-- CHANGE: language changed from plsql to sql
	     Replaced Oracle {call PROC_GL_COST_CENTRE_FLAT_R_PRT(..., ORACLE_REF_CURSOR)} with
	     PostgreSQL wrapper function fn_gl_cost_centre_flat_r_prt() that returns TABLE.
	     COMPANY_POID is multiselect array (numeric[]) in PostgreSQL; Oracle used single NUMBER.
	     The multiselect value arrives as text ("[1, 2]" / "1,2"), so it is normalised to numeric[]
	     the same way as DivisionWiseComparisonPeriodSubreport does.
	     PERIOD and PERIOD2 cast to ::date.
	     PROFIT_TYPE hardcoded as 'GROSS_PROFIT' in Oracle call — kept as parameter pass-through.
	     No schema prefix - schema resolved at runtime. -->
	<queryString language="sql">
		<![CDATA[SELECT * FROM fn_gl_cost_centre_flat_r_prt(
	('{' || TRANSLATE(CAST($P{COMPANY_POID} AS TEXT), '[] ', '') || '}')::numeric[],
	$P{PERIOD}::date,
	$P{PERIOD2}::date,
	'GROSS_PROFIT',
	$P{LEVEL_LIMIT}
)]]>
	</queryString>

<parameter name="COMPANY_POID" class="java.lang.String"/>
<parameter name="PERIOD" class="java.lang.String"/>
<parameter name="PERIOD2" class="java.lang.String"/>
<parameter name="LEVEL_LIMIT" class="java.lang.String"/>
<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
	<defaultValueExpression><![CDATA["//shippingbahrain.com/data/ERP_REPORTS/Reports/"]]></defaultValueExpression>
</parameter>
<parameter name="SUB_HEADER" class="net.sf.jasperreports.engine.JasperReport"/>
<parameter name="REPORT_DATE" class="java.util.Date"/>
<!-- CHANGE: Main query updated
     - Replaced Oracle DECODE() with PostgreSQL CASE WHEN
     - COMPANY_POID is a java.lang.String parameter, so JDBC binds it as varchar.
       Comparing it directly to the integer literal 999 raised
       "operator does not exist: character varying = integer".
     - COMPANY_POID is multiselect (comma-separated); normalised once in CTE "p"
       into numeric[] via translate()+string_to_array(), then compared with ANY().
       translate() strips braces/spaces so both '1,2,3' and '{1,2,3}' work.
     - COMPANY_POID=999 check → 999 = ANY(p.poids)
     - COMPANY_POID LIKE '%999%' check → 999 = ANY(p.poids)
     - No schema prefix - schema resolved at runtime -->
<queryString>
	<![CDATA[WITH p AS (
    SELECT string_to_array(translate(CAST($P{COMPANY_POID} AS TEXT), '{} ', ''), ',')::numeric[] AS poids
)
SELECT DISTINCT COMPANY_NAME, COMPANY_POID
FROM (
    SELECT
        CASE
            WHEN 999 = ANY(p.poids) THEN 'All Companies'
            ELSE GCM.COMPANY_NAME
        END AS COMPANY_NAME,
        CASE
            WHEN 999 = ANY(p.poids) THEN 1::numeric
            ELSE GCM.COMPANY_POID
        END AS COMPANY_POID
    FROM GLOBAL_COMPANY_MASTER GCM
    CROSS JOIN p
    WHERE 999 = ANY(p.poids)
       OR GCM.COMPANY_POID = ANY(p.poids)
) sub
]]>
</queryString>
<field name="COMPANY_NAME" class="java.lang.String"/>
<field name="COMPANY_POID" class="java.math.BigDecimal"/>

<!--             ELSE GCM.COMPANY_NAME-->
<!--        END AS COMPANY_NAME,-->
<!--        $P{CUSTOMER} AS CUSTOMER,-->
<!--        $P{LINE1} AS LINE,-->
<!--        PRODUCTION.GET_LINE_NAME_PARMETER_STR($P{LINE1}) AS LINE_NAME-->
<!--    FROM GLOBAL_COMPANY_MASTER GCM-->
<!--    WHERE 999 = ANY($P{COMPANY_POID_CSV}::numeric[])-->
<!--       OR GCM.COMPANY_POID = ANY($P{COMPANY_POID_CSV}::numeric[])-->
<!--) AS subquery]]>-->
<!--	</queryString>-->

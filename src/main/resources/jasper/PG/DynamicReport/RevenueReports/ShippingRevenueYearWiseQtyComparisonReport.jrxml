	<subDataset name="QtyDetail" uuid="b68f31e0-54c2-4914-a8bc-467eb2cfe3ce">
		<parameter name="COMPANY_POID" class="java.lang.String"/>
        <parameter name="COMPANY_POID_CSV" class="java.lang.String"/>
		<parameter name="PERIOD" class="java.util.Date"/>
		<parameter name="PERIOD2" class="java.util.Date"/>
		<parameter name="LINE1" class="java.lang.String"/>
		<parameter name="CUSTOMER" class="java.lang.String"/>
		<parameter name="BL_TYPE" class="java.lang.String"/>
		<parameter name="CNT_TYPE" class="java.lang.String"/>
		<parameter name="COM_YEAR" class="java.lang.String"/>
		<!-- CHANGE: language changed from plsql to sql
		     Replaced Oracle {call PROC_DYN_CNT_YEAR_WISE_RPT_PRT(..., ORACLE_REF_CURSOR)} with
		     PostgreSQL wrapper function fn_dyn_cnt_year_wise_rpt_prt() that returns TABLE.
		     COMPANY_POID is multiselect array (numeric[]) in PostgreSQL; Oracle used single NUMBER.
		     PERIOD and PERIOD2 cast to ::date.
		     No schema prefix - schema resolved at runtime. -->
        <queryString language="sql">
<!--            <![CDATA[SELECT * FROM fn_dyn_cnt_year_wise_rpt_prt( $P{COMPANY_POID_CSV}, $P{PERIOD}, $P{PERIOD2}, $P{LINE1}, $P{CUSTOMER}, $P{BL_TYPE}, $P{CNT_TYPE}, $P{COM_YEAR} )]]>-->
                <![CDATA[SELECT * FROM fn_dyn_cnt_year_wise_rpt_prt( string_to_array($P{COMPANY_POID_CSV}, ',')::numeric[], $P{PERIOD}, $P{PERIOD2}, $P{LINE1}, $P{CUSTOMER}, $P{BL_TYPE}, $P{CNT_TYPE}, $P{COM_YEAR} )]]>
        </queryString>
		<field name="YEARS" class="java.math.BigDecimal"/>
		<field name="IMPORT_20_FT" class="java.math.BigDecimal"/>
		<field name="IMPORT_40_FT" class="java.math.BigDecimal"/>
		<field name="IMPORT_TUES" class="java.math.BigDecimal"/>
		<field name="EXPORT_20_FT" class="java.math.BigDecimal"/>
		<field name="EXPORT_40_FT" class="java.math.BigDecimal"/>
		<field name="EXPORT_TUES" class="java.math.BigDecimal"/>
		<field name="TOTAL_20_FT" class="java.math.BigDecimal"/>
		<field name="TOTAL_40_FT" class="java.math.BigDecimal"/>
		<field name="TOTAL_TUES" class="java.math.BigDecimal"/>
		<field name="PER_YEAR_TO_YEAR" class="java.lang.String"/>
		<field name="CUMULATIVE_GROWTH" class="java.lang.String"/>
	</subDataset>
	<parameter name="COMPANY_POID" class="java.lang.String"/>
    <parameter name="COMPANY_POID_CSV" class="java.lang.String"/>	<parameter name="PERIOD" class="java.util.Date"/>
	<parameter name="PERIOD2" class="java.util.Date"/>
	<parameter name="LINE1" class="java.lang.String"/>
	<parameter name="CUSTOMER" class="java.lang.String"/>
	<parameter name="BL_TYPE" class="java.lang.String"/>
	<parameter name="CNT_TYPE" class="java.lang.String"/>
	<parameter name="COM_YEAR" class="java.lang.String"/>
	<parameter name="REPORT_DATE" class="java.util.Date"/>
	<!-- CHANGE: Main query updated
	     - Replaced Oracle DECODE() with PostgreSQL CASE WHEN
	     - COMPANY_POID is multiselect array; using ANY() for array comparison
	     - GET_LINE_NAME_PARMETER_STR() kept as-is (confirm function exists in PostgreSQL) -->

    <queryString language="sql">
        <![CDATA[SELECT * FROM fn_rpt_header_company_line_customer( $P{COMPANY_POID_CSV}, $P{CUSTOMER}, $P{LINE1})]]>
    </queryString>
<!--    <queryString>-->
<!--		<![CDATA[SELECT DISTINCT COMPANY_NAME, CUSTOMER, LINE, LINE_NAME-->
<!--FROM (-->

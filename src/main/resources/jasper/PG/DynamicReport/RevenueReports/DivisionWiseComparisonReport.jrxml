  <parameter name="COMPANY_POID" class="java.lang.String"/>
  <!-- COMPANY_POID holds only the first selected company; COMPANY_POID_CSV carries the full multiselect list -->
  <parameter name="COMPANY_POID_CSV" class="java.lang.String"/>
  <parameter name="PERIOD" class="java.lang.String"/>
  <parameter name="PERIOD2" class="java.lang.String"/>
  <parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
    <defaultValueExpression><![CDATA["\\\\shippingbahrain.com\\data\\ERP_REPORTS\\Reports\\"]]></defaultValueExpression>
  </parameter>
  <parameter name="PROFIT_TYPE" class="java.lang.String">
    <defaultValueExpression><![CDATA["GROSS_PROFIT"]]></defaultValueExpression>
  </parameter>
  <parameter name="COST_GROUP" class="java.lang.String" isForPrompting="false">
    <defaultValueExpression><![CDATA["GL_COST_CENTRE"]]></defaultValueExpression>
  </parameter>
  <parameter name="GROUP_GL_POID" class="java.lang.String"/>
  <parameter name="FFS_ALLOCATE_TO" class="java.lang.String">
    <defaultValueExpression><![CDATA["SH"]]></defaultValueExpression>
  </parameter>
  <parameter name="SUBREPORT1" class="net.sf.jasperreports.engine.JasperReport"/>
  <parameter name="OTHER_INCOME" class="java.lang.String"/>
  <parameter name="USER_POID" class="java.lang.String"/>
  <parameter name="REPORT_DATE" class="java.util.Date"/>
  <queryString language="sql">
    <![CDATA[WITH p AS (
    SELECT ('{' || TRANSLATE(CAST($P{COMPANY_POID_CSV} AS TEXT), '[] ', '') || '}')::numeric[] AS poids
)
SELECT
    CASE
        WHEN 999 = ANY(p.poids) THEN 'All Companies'
        ELSE (
            SELECT STRING_AGG(DISTINCT GCM.COMPANY_NAME, ',' || CHR(10) ORDER BY GCM.COMPANY_NAME)
            FROM GLOBAL_COMPANY_MASTER GCM
            WHERE GCM.COMPANY_POID = ANY(p.poids)
        )
    END AS COMPANY_NAME,
    CASE
        WHEN $P{OTHER_INCOME}='Y' AND $P{PROFIT_TYPE}='GROSS_PROFIT' THEN 'Included'
        WHEN $P{PROFIT_TYPE}='NET_PROFIT' THEN 'Included'
        ELSE 'Excluded'
    END AS OTHER_INCOME
FROM p]]>
  </queryString>
  <field name="COMPANY_NAME" class="java.lang.String"/>
  <field name="OTHER_INCOME" class="java.lang.String"/>
